# ─── Base de datos (Railway PostgreSQL) ───
DATABASE_URL="postgresql://user:password@host:5432/calatafest"

# ─── Redis (cola BullMQ + rate-limit) ───
REDIS_URL="redis://localhost:6379"

# ─── Auth.js ───
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# ─── Storage ───
# Driver: railway-volume | r2 | s3
STORAGE_DRIVER="railway-volume"
STORAGE_PATH="/data/uploads"
# (Cuando se migre a R2/S3, rellenar credenciales del bucket aquí.)

# ─── Google Vision (moderación IA) ───
# Si NO se define ninguna, la IA se desactiva y las fotos quedan PENDING (manual).
# Opción A (Railway-friendly): pega el JSON del service account como string.
# GOOGLE_VISION_CREDENTIALS='{"type":"service_account","project_id":"...", ...}'
# Opción B: ruta al fichero JSON del service account (ADC).
# GOOGLE_APPLICATION_CREDENTIALS="/app/gcp-vision.json"

# ─── Sitio ───
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Seed (solo desarrollo) ───
SEED_SUPERADMIN_EMAIL="lopez@karaokemedia.com"
SEED_SUPERADMIN_PASSWORD="cambia-esto"
